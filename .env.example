# TerraQuery Environment Configuration
# Oracle AI Database 26ai & Select AI (DBMS_CLOUD_AI) Credentials
# NEVER commit real credentials to version control.

# Mode: 'prototype' (simulated offline mode) or 'live' (active Oracle 26ai)
TERRAQUERY_MODE=prototype

# Oracle Autonomous AI Database 26ai Connection
ORACLE_CONNECTION_STRING=jdbc:oracle:thin:@tcps://climate-db.oraclecloud.com:1522/cqdb_high.adb.oraclecloud.com
ORACLE_USERNAME=ADMIN_CLIMATE_AI
ORACLE_PASSWORD=YourSecureOraclePasswordHere

# Select AI Configuration (DBMS_CLOUD_AI)
AI_PROFILE=CLIMATE_SELECT_AI_V2
AI_PROVIDER=oci
AI_MODEL=cohere.command-r-plus
AI_API_KEY=ocid1.vaultsecret.oc1.ap-mumbai-1.amaaaaaa...

# Security Boundaries
DB_ROLE=ROLE_CLIMATE_ANALYTICS_RO
SCHEMA_VIEW=CLIMATE_INTEL_2026.CLIMATE_DATA
READ_ONLY_ENFORCED=true
AST_VALIDATION_ENABLED=true
